---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleNavigation from "../../components/ArticleNavigation.astro";
import PostMeta from "../../components/PostMeta.astro";
import PostOutline from "../../components/PostOutline.astro";
import { readingMinutes } from "../../lib/reading";
import { getArchivePosts, type ArchivePost } from "../../lib/archive";
export function getStaticPaths(){return getArchivePosts().map(post=>({params:{slug:post.slug},props:{post}}))}
const {post}=Astro.props as {post:ArchivePost};
---
<BaseLayout title={`${post.title} — Jesse Anderson`} description={`An archived field note from ${post.date.getFullYear()}.`} article={{ published: post.date, tags: post.tags }} image={`/social/archive/${post.slug}.png`}>
  <main id="main-content" tabindex="-1" class="post shell">
    <a class="text-link back-link" href="/archive/">← Archive</a>
    <article>
      <p class="mono section-number">ARCHIVE / {post.date.getFullYear()}</p>
      <h1>{post.title}</h1>
      <PostMeta published={post.date} minutes={readingMinutes(post.html)} tags={post.tags} />
      <PostOutline headings={post.headings} />
      <div class="post-body" set:html={post.html}></div>
    </article>
    <ArticleNavigation archive />
  </main>
</BaseLayout>
